{
  "schemaVersion": 1,
  "id": "quark-sites",
  "name": "Sites Quark",
  "version": "1.0.0",
  "description": "Les sept sites de recherche fournis avec Quark.",
  "homepage": "https://github.com/Matheotaku4/Quark",
  "sites": [
    {
      "id": "gamebounty",
      "label": "GameBounty",
      "host": "gamebounty.st",
      "searchUrl": "https://gamebounty.st/search?q={query}",
      "driver": "gamebounty"
    },
    {
      "id": "ankergames",
      "label": "AnkerGames",
      "host": "ankergames.net",
      "searchUrl": "https://ankergames.net/search?q={query}",
      "driver": "ankergames"
    },
    {
      "id": "astralgames",
      "label": "AstralGames",
      "host": "astralgames.net",
      "searchUrl": "https://astralgames.net/search?q={query}",
      "driver": "astralgames"
    },
    {
      "id": "kryoto",
      "label": "Kryoto",
      "host": "kryo.to",
      "searchUrl": "https://kryo.to/catalog?q={query}",
      "driver": "kryoto"
    },
    {
      "id": "onlinefix",
      "label": "Online-Fix",
      "host": "online-fix.me",
      "searchUrl": "https://online-fix.me/index.php?do=search&subaction=search&story={query}",
      "driver": "onlinefix"
    },
    {
      "id": "zeigames",
      "label": "ZeiGames",
      "host": "zeigames.com",
      "searchUrl": "https://zeigames.com/search/?q={query}",
      "driver": "zeigames"
    },
    {
      "id": "scenecat",
      "label": "scene.cat",
      "host": "scene.cat",
      "searchUrl": "https://scene.cat/?q={query}",
      "driver": "scenecat"
    }
  ]
}
